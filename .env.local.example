# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit .env.local or paste a real key into a tracked file.

# Required — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — defaults to openai/gpt-4o-mini if unset. Any OpenRouter model id works.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional — used for the OpenRouter HTTP-Referer header. Set to your deployed domain.
SITE_URL=https://christopherneale.dev
