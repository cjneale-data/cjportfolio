{
  "functions": {
    "api/chat.js": {
      "includeFiles": "content/career-master.md"
    }
  },
  "rewrites": [
    {
      "source": "/for/:slug",
      "destination": "/for.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "cjportfolio-inky.vercel.app"
        }
      ],
      "destination": "https://cjneale.xyz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cjneale.xyz"
        }
      ],
      "destination": "https://cjneale.xyz/:path*",
      "permanent": true
    }
  ]
}
